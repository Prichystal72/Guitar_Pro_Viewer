      "line": 5,
      "track_index": 1,
      "line_start": true
    },
    {
      "time_s": 83.077,
      "duration_s": 7.385,
      "text": "Ref: Pěnu s vůní jablečnou, vyvanulý sprej,",
      "measure": 10,
