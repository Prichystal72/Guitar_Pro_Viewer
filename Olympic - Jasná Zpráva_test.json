  "lyrics_timeline": [
    {
      "time_s": 46.154,
      "duration_s": 3.692,
      "text": "1. Skončili jsme, jasná zpráva,",
      "measure": 4,
      "line": 0,
      "track_index": 1,
      "line_start": false
    },
    {
      "time_s": 49.846,
      "duration_s": 3.693,
      "text": "proč o Tebe zakopávám dál,",
      "measure": 5,
      "line": 1,
      "track_index": 1,
      "line_start": true
    },
    {
      "time_s": 57.231,
      "duration_s": 3.692,
      "text": "projít bytem já abych se bál.",
      "measure": 6,
      "line": 2,
      "track_index": 1,
      "line_start": true
    },
    {
      "time_s": 64.615,
      "duration_s": 3.692,
      "text": "2. Dík tobě se vidím zvenčí,",
      "measure": 7,
      "line": 3,
      "track_index": 1,
      "line_start": true
    },
    {
      "time_s": 68.308,
      "duration_s": 3.692,
      "text": "připadám si starší, menší sám,",
      "measure": 8,
      "line": 4,
      "track_index": 1,
      "line_start": true
    },
    {
      "time_s": 75.692,
      "duration_s": 3.693,
      "text": "kam se kouknu, kousek Tebe mám.",
