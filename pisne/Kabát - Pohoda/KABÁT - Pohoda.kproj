    {
      "name": "Refrén",
      "startBar": 21,
      "source": "manual",
      "lyrics": [
        {
          "bar": 21,
          "beat": 3.0,
          "text": "R: Když se u nás chlapi poperou,",
          "source": "manual"
        },
        {
          "bar": 23,
          "beat": 3.0,
          "text": "tak jenom nožem anebo sekerou.",
          "source": "manual"
        },
        {
          "bar": 25,
          "beat": 3.0,
          "text": "V zimě tam dlouhý noci jsou a tuhej mráz!",
          "source": "manual"
        },
        {
          "bar": 27,
          "beat": 3.0,
          "text": "Jak jsou naše cesty zavátý,",
          "source": "manual"
        },
        {
          "bar": 29,
          "beat": 3.0,
          "text": "tak vezmem vidle a nebo lopaty,",
          "source": "manual"
        },
        {
          "bar": 31,
          "beat": 3.0625,
          "text": "když něco nejde, co na tom sejde?",
          "source": "manual"
        },
        {
          "bar": 33,
          "beat": 3.0,
          "text": "My máme čas!",
          "source": "manual"
        }
      ],
