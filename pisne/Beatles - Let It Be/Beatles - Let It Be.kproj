      "lyrics": [
        {
          "bar": 2,
          "beat": 1.0,
          "text": "1. When I find myself in times of trouble",
          "source": "manual"
        },
        {
          "bar": 4,
          "beat": 1.0,
          "text": "Mother Mary comes to me",
          "source": "manual"
        },
        {
          "bar": 6,
          "beat": 1.0,
          "text": "speaking words of wisdom let it be",
          "source": "manual"
        },
        {
          "bar": 8,
          "beat": 1.0,
          "text": "and in my hour of darkness",
          "source": "manual"
        },
        {
          "bar": 10,
          "beat": 1.0,
          "text": "she is standing right in front of me",
          "source": "manual"
        },
        {
          "bar": 12,
