    {
      "name": "Sloka 3",
      "startBar": 31,
      "source": "manual",
      "lyrics": [
        {
          "bar": 32,
          "beat": 1.0,
          "text": "3. And when the night is cloudy",
          "source": "manual"
        },
        {
          "bar": 34,
          "beat": 1.0,
          "text": "there is still a light that shines on me",
          "source": "manual"
        },
        {
          "bar": 36,
          "beat": 1.0,
          "text": "shine until tomorrow let it be",
          "source": "manual"
        },
        {
          "bar": 38,
          "beat": 1.0,
          "text": "I wake up to the sound of music",
          "source": "manual"
        },
        {
          "bar": 40,
          "beat": 1.0,
          "text": "Mother Mary comes to me",
          "source": "manual"
        },
        {
          "bar": 42,
          "beat": 1.0,
          "text": "speaking words of wisdom let it be. R: ...",
