        {
          "bar": 18,
          "beat": 1.0,
          "text": "2. And when the broken hearted people",
          "source": "manual"
        },
        {
          "bar": 20,
          "beat": 1.0,
          "text": "living in the world agree",
          "source": "manual"
        },
        {
          "bar": 22,
          "beat": 1.0,
          "text": "there will be an answer let it be",
          "source": "manual"
        },
        {
