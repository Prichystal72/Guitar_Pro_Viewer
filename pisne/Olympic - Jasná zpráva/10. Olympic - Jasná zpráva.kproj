    {
      "name": "Refrén",
      "startBar": 23,
      "source": "generated",
      "lyrics": [
        {
          "bar": 23,
          "beat": 4.9375,
          "text": "Pěnu s vůní jablečnou, vyvanulý sprej,",
          "source": "manual"
        },
        {
          "bar": 26,
          "beat": 1.4,
          "text": "telefon, cos ustřihla mu šňůru.",
          "source": "manual"
        },
        {
          "bar": 28,
          "beat": 1.25,
          "text": "Knížku krásně zbytečnou, co má lživý děj,",
          "source": "manual"
        },
        {
          "bar": 30,
          "beat": 1.4,
          "text": "píše se v ní, jak se lítá vzhůru,",
          "source": "manual"
        },
        {
          "bar": 31,
          "beat": 3.75,
          "tMsOverride": 109620,
          "text": "lítá vzhůru, ve dvou vzhůru.",
          "source": "manual"
        }
      ],
