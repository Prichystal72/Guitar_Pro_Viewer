      "name": "Sloka 1",
      "startBar": 1,
      "source": "generated",
      "lyrics": [
        {
          "bar": 13,
          "beat": 1.0,
          "text": "Skončili jsme, jasná zpráva,",
          "source": "manual"
        },
        {
          "bar": 15,
          "beat": 1.25,
          "text": "proč o Tebe zakopávám dál,",
          "source": "manual"
        },
        {
          "bar": 17,
          "beat": 1.375,
          "text": "projít bytem já abych se bál.",
          "source": "manual"
        },
        {
          "bar": 17,
          "beat": 3.75,
          "text": "Dík tobě se vidím zvenčí,",
          "source": "manual"
        },
        {
          "bar": 20,
          "beat": 1.25,
          "tMsOverride": 66700,
          "text": "připadám si starší, menší sám,",
          "source": "manual"
        },
        {
          "bar": 22,
          "beat": 1.5,
          "tMsOverride": 74200,
          "text": "kam se kouknu, kousek Tebe mám.",
          "source": "manual"
        }
      ],
